rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Super Admin: either by Email or by SuperAdmin UID
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'alisohrab348@gmail.com' ||
        request.auth.token.email == 'badshahxfire@gmail.com' ||
        request.auth.uid == 'kTUardeKQAUjuKKyGplwUBe1seI3'
      );
    }

    // Staff check
    function isStaff() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/adminData/staffList) &&
        (request.auth.token.email in get(/databases/$(database)/documents/adminData/staffList).data.emails)
      );
    }

    function isAdmin() {
      return isSuperAdmin() || isStaff();
    }

    // ==========================================
    // 1. USERS COLLECTION (HACK PROOF)
    // ==========================================
    match /users/{userId} {
      // Any authenticated user can read public profile (needed for leaderboards, search)
      allow read: if isAuthenticated();

      // Creating a new user:
      // Normal users CANNOT start with hacked coins! Max 0 or 10 if referral.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (request.resource.data.coins == 0 || (request.resource.data.coins <= 10 && request.resource.data.referredBy != null)) &&
        request.resource.data.winCoins == 0 &&
        (!('isStaff' in request.resource.data) || request.resource.data.isStaff == false) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('blocked' in request.resource.data) || request.resource.data.blocked == false)
      );

      // Updating user profile:
      // ANTI-HACK: Normal user can ONLY update profile fields like ign, phone, ffId, fcmToken, etc.
      // They CANNOT modify coins, winCoins, role, isStaff, or blocked status!
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'winCoins', 'role', 'isStaff', 'blocked', 'isBlocked'])
      );

      // Only Super Admin can delete a user record
      allow delete: if isSuperAdmin();

      // Coin History Subcollection (Immutable ledger)
      match /coinHistory/{historyId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
        allow update, delete: if false; // CANNOT BE TAMPERED OR DELETED
      }
    }

    // ==========================================
    // 2. WALLET & TRANSACTIONS
    // ==========================================
    match /walletTransactions/{transactionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if false; // Permanent audit log
    }

    // ==========================================
    // 3. ADMIN DATA & STAFF MANAGEMENT
    // ==========================================
    match /adminData/{documentId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin(); // ONLY Super Admin can edit staff/permissions
    }

    // ==========================================
    // 4. TOURNAMENTS & RESULTS
    // ==========================================
    match /tournaments/{tournamentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only Admin/Staff can create or edit matches
    }

    match /matchResults/{resultId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only Admin/Staff can upload or edit results
    }

    // ==========================================
    // 5. DEFAULT FALLBACK
    // ==========================================
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
