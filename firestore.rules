rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if the user is the Super Admin
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.uid == 'FAVc9zfAgoYs1d1BDr2EoDwSw0x1';
    }

    // Helper function to check if user is Staff
    function isStaff() {
      return isAuthenticated() && exists(/databases/$(database)/documents/adminData/staffList) && (request.auth.token.email in get(/databases/$(database)/documents/adminData/staffList).data.emails);
    }

    // Helper function to check if the user is ANY admin (Super Admin or Staff)
    function isAdmin() {
      return isSuperAdmin() || isStaff();
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for leaderboards, search etc.)
      allow read: if isAuthenticated();
      
      // A user can create their own profile, but must initialize coins/winCoins correctly
      allow create: if (isOwner(userId) 
        && ((request.resource.data.coins == 0) || (request.resource.data.coins == 10 && request.resource.data.referredBy != null))
        && request.resource.data.winCoins == 0) || isAdmin();

      // PHASE 1: MEDIUM SECURITY (Will NOT break your current app)
      // Allow users to update their own document (including coins for now)
      // but prevents them from editing other users' documents.
      allow update: if isOwner(userId) || isAdmin();

      /*
      // PHASE 2: HIGH SECURITY (Apply this AFTER setting up Cloud Functions)
      // Users can update their profile but CANNOT modify 'coins' or 'winCoins' fields.
      // Admin can update anything.
      allow update: if isAdmin() || (isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins', 'winCoins'])));
      */

      // Rules for user's coin history subcollection
      match /coinHistory/{historyId} {
        // Only the owner or admin can read their own coin history
        allow read: if isOwner(userId) || isAdmin();
        // Only allow writes if the owner is creating a log
        allow create: if isOwner(userId) || isAdmin();
        // Nobody can update or delete history logs
        allow update, delete: if false;
      }
    }

    // Rules for 'walletTransactions' collection (payment/withdrawal transaction logs)
    match /walletTransactions/{transactionId} {
      // Authenticated users can create a transaction log for themselves, or admin can
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid) || isAdmin();
      
      // Users can only read their own transactions, or admin can read all
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Nobody can update or delete transactions once written
      allow update, delete: if false;
    }

    // Rules for 'adminData' collection
    match /adminData/{documentId} {
      allow read: if isAuthenticated();
      // Only Super Admin can modify staff list and admin data
      allow write: if isSuperAdmin();
    }

    // Default rules for all other collections (tournaments, matchResults, etc.)
    // This restores the ability for users to read matches and join them, and admins to manage them.
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
